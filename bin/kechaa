#!/usr/bin/env -S python3 -IS
"""Source-checkout launcher. Install with tools/install.py for a pinned interpreter."""
import sys
import os
import stat
from pathlib import Path

LIB_DIRECTORY = ""
application = Path(__file__).resolve().parent.parent / LIB_DIRECTORY
if not sys.flags.isolated or not sys.flags.no_site:
    raise SystemExit("Start this entrypoint with Python -IS; site hooks must be disabled.")
if os.geteuid() == 0:
    # Validate even cached bytecode before importing any application module.
    package = application / "kechaa"
    for path in (package, *package.parents):
        st = path.lstat()
        if st.st_uid != 0 or st.st_mode & 0o022 or stat.S_ISLNK(st.st_mode):
            raise SystemExit("Unsafe application path; root startup refused: " + str(path))
    count = 0
    for parent, directories, files in os.walk(package, followlinks=False):
        for name in directories + files:
            path = Path(parent) / name
            st = path.lstat()
            count += 1
            if (count > 4096 or st.st_uid != 0 or st.st_mode & 0o022 or
                    not (stat.S_ISREG(st.st_mode) or stat.S_ISDIR(st.st_mode))):
                raise SystemExit("Unsafe application entry; root startup refused: " + str(path))
sys.path.insert(0, str(application))
from kechaa.bootstrap import main

raise SystemExit(main())
